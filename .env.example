# Nexxauth identity provider
NEXT_PUBLIC_NEXXAUTH_BASE_URL=https://auth.nexxserve.dev/cavgo
NEXT_PUBLIC_NEXXAUTH_CLIENT_ID=

# Cavgo API gateway (used to load the signed-in user's company membership)
NEXT_PUBLIC_API_URL=https://api.gocavgo.com

# Optional override; defaults to https://api.gocavgo.com/agg/graphql
NEXT_PUBLIC_GRAPHQL_API_URL=https://api.gocavgo.com/agg/graphql
